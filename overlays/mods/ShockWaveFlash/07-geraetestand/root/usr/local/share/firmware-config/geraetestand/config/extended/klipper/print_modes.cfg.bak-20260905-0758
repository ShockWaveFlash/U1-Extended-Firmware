# Stealth / Normal Mode ("Nachtmodus") -- nach dem Vorbild von Prusas Power-Modes.
# Wiederhergestellt 2026-08-06 nach dem Config-Reset, danach um den M204-Deckel erweitert.
#
# Prinzip: Der leise Betrieb kommt ganz ueberwiegend von REDUZIERTER
# BESCHLEUNIGUNG, nicht vom Treibermodus. Bei Prusa faellt zwischen Normal und
# Stealth die Beschleunigung um 62 %, die Geschwindigkeit nur um 14 % -- beim
# Anfahren braucht der Motor sein maximales Drehmoment, dort entsteht der Laerm.
#
# ============================================================================
# WARUM DER M204-DECKEL NOETIG IST (gemessen 2026-08-06):
# SET_VELOCITY_LIMIT allein reicht NICHT. Der Slicer schreibt laufend eigene
# M204-Befehle in den G-Code (beobachtet: S10000 im Start-G-Code, spaeter 5000
# je nach Druckbereich) und ueberschreibt damit jede Vorgabe innerhalb von
# Sekunden. Genau wie bei der Betttemperatur gewinnt der G-Code.
# Deshalb faengt das Makro unten M204 ab und deckelt den Wert auf das Limit des
# aktiven Modus. Geschwindigkeit und SCV bleiben von SET_VELOCITY_LIMIT gesetzt,
# die haelt der Slicer nicht dagegen.
# ============================================================================
#
# ⚠️ BEWUSST OHNE AUTOTUNE: Frueher standen hier AUTOTUNE_TMC-Aufrufe. Die sind
# raus und duerfen NICHT zurueck. Gruende:
#   1. klipper_tmc_autotune ist deaktiviert -- ein Aufruf des nicht existierenden
#      Makros bricht das Makro ab, BEVOR SET_VELOCITY_LIMIT laeuft. Der Modus
#      taete dann gar nichts (genau so ist es am 2026-08-06 passiert).
#   2. AutoTune ist mit dem TMC2240 unvertraeglich und zerstoert das sensorlose
#      XY-Homing (fremdbestaetigt, Issue #154 im Plugin-Repo).
#
# NORMAL : 500 mm/s / 20000 mm/s^2 / SCV 8 / Tempo 100 %   (kein Deckel)
# STEALTH: 250 mm/s /  2500 mm/s^2 / SCV 3 / Tempo  30 %   (Deckel greift)
#
# DIE DREI HEBEL, in der Reihenfolge ihrer Wirkung:
#   1. M220 (Tempofaktor)  -- global, der Slicer setzt ihn NICHT zurueck.
#      Senkt zugleich die tatsaechlich gefahrene Beschleunigung mit.
#      Praxiswert 2026-08-06: bei 60 % fiel max_accel auf 5000, bei 45 % auf 2500.
#   2. M204-Deckel         -- kappt die Slicer-Vorgaben nach oben.
#   3. SET_VELOCITY_LIMIT  -- setzt Obergrenzen fuer Tempo und SCV.
# Die 45 % stammen aus dem ABS-Nachtdruck vom 2026-08-06 und waren dort hoerbar
# ruhig. Preis: Der Druck dauert gut das Doppelte. Unter etwa 30 % nicht gehen --
# bei ABS leidet sonst die Schichthaftung, weil jede Lage zu lange abkuehlt.
#
# Umschalten wirkt SOFORT, auch mitten im Druck.
#
# last-wins Overlay -- ueberlebt Firmware-Updates.

[gcode_macro PRINT_MODE]
description: Interner Zustandsspeicher fuer STEALTH_MODE / NORMAL_MODE
variable_current: 'normal'
variable_accel_limit: 20000
gcode:
    RESPOND MSG="Modus: {printer['gcode_macro PRINT_MODE'].current} | Beschleunigungsdeckel: {printer['gcode_macro PRINT_MODE'].accel_limit} mm/s2"

[gcode_macro STEALTH_MODE]
description: Leiser Modus - reduzierte Limits (250 mm/s, 2500 mm/s2, Tempo 30 %)
gcode:
    SET_GCODE_VARIABLE MACRO=PRINT_MODE VARIABLE=accel_limit VALUE=2500
    SET_GCODE_VARIABLE MACRO=PRINT_MODE VARIABLE=current VALUE='"stealth"'
    SET_VELOCITY_LIMIT VELOCITY=250 ACCEL=2500 SQUARE_CORNER_VELOCITY=3
    M220 S30
    RESPOND MSG="STEALTH: leise | 30 % Tempo | 2500 mm/s2 | Slicer-SET_VELOCITY_LIMIT wird gedeckelt | Druck dauert etwa dreimal so lang"

[gcode_macro NORMAL_MODE]
description: Normaler Modus - volle Leistung (500 mm/s, 20000 mm/s2, Tempo 100 %)
gcode:
    SET_GCODE_VARIABLE MACRO=PRINT_MODE VARIABLE=accel_limit VALUE=20000
    SET_GCODE_VARIABLE MACRO=PRINT_MODE VARIABLE=current VALUE='"normal"'
    SET_VELOCITY_LIMIT VELOCITY=500 ACCEL=20000 SQUARE_CORNER_VELOCITY=8
    M220 S100
    RESPOND MSG="NORMAL: volle Leistung | 100 % Tempo | 20000 mm/s2 | kein Deckel"

# Faengt die M204-Befehle des Slicers ab und begrenzt sie auf accel_limit.
# Im NORMAL_MODE steht das Limit auf 20000 = dem printer.cfg-Wert, der Deckel
# aendert dort also nichts. Unbekannte Parameter werden unveraendert
# durchgereicht, damit nichts verlorengeht.
[gcode_macro M204]
rename_existing: M204.1
description: M204 mit Beschleunigungsdeckel je nach Druckmodus
gcode:
    {% set cap = printer['gcode_macro PRINT_MODE'].accel_limit | float %}
    {% set out = namespace(args='') %}
    {% if 'S' in params %}
        {% set out.args = out.args ~ ' S' ~ ([params.S | float, cap] | min) %}
    {% endif %}
    {% if 'P' in params %}
        {% set out.args = out.args ~ ' P' ~ ([params.P | float, cap] | min) %}
    {% endif %}
    {% if 'T' in params %}
        {% set out.args = out.args ~ ' T' ~ ([params.T | float, cap] | min) %}
    {% endif %}
    M204.1{out.args}


# ============================================================================
# WARUM DER M204-DECKEL OBEN NICHT REICHT (gemessen 2026-09-05):
# Snapmaker Orca schreibt im Klipper-Flavor NICHT M204, sondern direkt
# SET_VELOCITY_LIMIT. Auszaehlung der laufenden Datei shelf1_PETG_23h52m.gcode:
#   M204-Zeilen        :      1
#   SET_VELOCITY_LIMIT : 11.782   (im Wechsel ACCEL=10000 und ACCEL=5000)
# Der M204-Deckel fing also einen Befehl ab, der genau einmal vorkommt, und lief
# ins Leere -- trotz aktivem STEALTH_MODE standen 10000 mm/s^2 in der Maschine.
# Deshalb wird SET_VELOCITY_LIMIT hier genauso gedeckelt wie M204.
# Der M204-Deckel oben bleibt trotzdem drin: andere Slicer schreiben M204.
# ============================================================================
[gcode_macro SET_VELOCITY_LIMIT]
rename_existing: SET_VELOCITY_LIMIT_BASE
description: SET_VELOCITY_LIMIT mit Beschleunigungsdeckel je nach Druckmodus
gcode:
    {% if 'gcode_macro PRINT_MODE' in printer %}
        {% set cap = printer['gcode_macro PRINT_MODE'].accel_limit | float %}
    {% else %}
        {% set cap = 20000 | float %}
    {% endif %}
    {% set out = namespace(args='') %}
    {% if 'ACCEL' in params %}
        {% set out.args = out.args ~ ' ACCEL=' ~ ([params.ACCEL | float, cap] | min) %}
    {% endif %}
    {% if 'ACCEL_TO_DECEL' in params %}
        {% set out.args = out.args ~ ' ACCEL_TO_DECEL=' ~ ([params.ACCEL_TO_DECEL | float, cap / 2] | min) %}
    {% endif %}
    {% if 'VELOCITY' in params %}
        {% set out.args = out.args ~ ' VELOCITY=' ~ params.VELOCITY %}
    {% endif %}
    {% if 'SQUARE_CORNER_VELOCITY' in params %}
        {% set out.args = out.args ~ ' SQUARE_CORNER_VELOCITY=' ~ params.SQUARE_CORNER_VELOCITY %}
    {% endif %}
    {% if 'MINIMUM_CRUISE_RATIO' in params %}
        {% set out.args = out.args ~ ' MINIMUM_CRUISE_RATIO=' ~ params.MINIMUM_CRUISE_RATIO %}
    {% endif %}
    SET_VELOCITY_LIMIT_BASE{out.args}
