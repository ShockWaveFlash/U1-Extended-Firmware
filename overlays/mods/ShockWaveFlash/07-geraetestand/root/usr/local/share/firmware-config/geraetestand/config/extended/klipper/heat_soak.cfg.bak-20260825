# HEAT_SOAK -- Vorheizen fuer ABS/ASA ohne aktive Kammerheizung.
# Angelegt 2026-08-06, am selben Tag GRUNDLEGEND UEBERARBEITET.
#
# ============================================================================
# WARUM KEINE TEMPERATURWARTUNG MEHR (wichtig, nicht wieder einbauen):
# Die erste Fassung nutzte TEMPERATURE_WAIT auf den Kammersensor. Das hat den
# Drucker am 2026-08-06 komplett blockiert: Die Kammer erreichte die
# geforderten 50 C nie (blieb bei 39-40 C), und TEMPERATURE_WAIT kennt KEIN
# Zeitlimit. Der Druck stand 30 Minuten mit Bett auf 110 C und Duese auf 270 C.
# Schlimmer: TEMPERATURE_WAIT blockiert Klippers GESAMTE Befehlswarteschlange.
# Es half NICHTS davon -- alle Befehle landeten hinter der Blockade:
#   CANCEL_PRINT / Moonraker /printer/print/cancel   -> wirkungslos
#   FIRMWARE_RESTART ueber Moonraker                 -> wirkungslos
#   M112                                             -> wirkungslos
#   Abbrechen am Touchscreen                         -> wirkungslos
#   /printer/emergency_stop                          -> gibt es nicht (404)
# Einziger Ausweg war per SSH: /etc/init.d/S60klipper restart
#
# Ein Zeitlimit laesst sich in einem Klipper-Makro auch nicht nachruesten:
# Jinja wird EINMAL beim Aufruf gerendert, eine Warteschleife mit laufend
# geprueftem Abbruch ist damit nicht baubar.
# ============================================================================
#
# Deshalb jetzt: feste Durchwaermzeit. Das ist ohnehin die uebliche Bedeutung
# von "Heat Soak" -- nicht die Luft soll eine Zahl erreichen, sondern Rahmen
# und Bett sollen durchwaermt sein.
#
# Aufruf:
#   HEAT_SOAK                        -> Bett 110 C, danach 15 min durchwaermen
#   HEAT_SOAK BED=110 MINUTES=20     -> eigene Werte
#   HEAT_SOAK BED=110 CHAMBER=50     -> CHAMBER wird IGNORIERT (Rueckwaerts-
#                                       kompatibilitaet fuer alte Slicer-
#                                       Profile; blockiert nicht mehr)
#
# Einbau im Slicer: erste Zeile im Filament-Start-G-Code des ABS-Profils.
#
# Realistisch erreichbar in Christophers Aufbau (Bett 110 C, ohne Panda
# Breath): etwa 40 C Kammer. Snapmakers Angabe von 50 C gilt mit montiertem
# Top Cover unter guenstigeren Bedingungen.
#
# last-wins Overlay -- ueberlebt Firmware-Updates.

[gcode_macro HEAT_SOAK]
description: Bett heizen und Bauraum durchwaermen (ABS/ASA ohne Kammerheizung)
gcode:
    {% set bed = params.BED|default(110)|float %}
    {% set minutes = params.MINUTES|default(15)|int %}
    RESPOND MSG="HEAT_SOAK: Bett auf {bed} C, danach {minutes} min durchwaermen (Deckel und Tueren zu!)"
    M140 S{bed}
    M190 S{bed}
    RESPOND MSG="HEAT_SOAK: Bett bereit, Kammer {printer['temperature_sensor cavity'].temperature} C -- jetzt {minutes} min warten"
    G4 P{minutes * 60000}
    RESPOND MSG="HEAT_SOAK fertig: Kammer {printer['temperature_sensor cavity'].temperature} C -- Druck startet"
