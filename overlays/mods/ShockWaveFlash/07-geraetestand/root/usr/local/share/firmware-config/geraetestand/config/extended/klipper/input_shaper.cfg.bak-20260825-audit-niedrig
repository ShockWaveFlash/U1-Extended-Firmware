# Schwingungsausgleich - gemessen, nicht geraten.
#
# ★★ RANGFOLGE (2026-08-25 am Geraet nachgesehen, Audit-Befund "doppelte
#    [input_shaper]-Sektion"). Es gibt DREI Stellen, und die letzte gewinnt:
#
#   1. printer.cfg:89   [input_shaper] mzv 54 / 47.5   <- Werksfassung von Snapmaker.
#      Sie steht VOR "[include extended/klipper/*.cfg]" (printer.cfg:1348), wird also
#      von dieser Datei hier ueberstimmt. Nicht anfassen: printer.cfg wird bei jedem
#      Flash ueberschrieben und von Snapmakers eigenem Code beschrieben.
#   2. DIESE DATEI  -> der Wert, auf den der Drucker zurueckfaellt, wenn das JSON
#      unten fehlt (frischer Flash, full-recover). Nur DAFUER ist sie da.
#   3. snapmaker/input_shaper.json  -> ★ DAS IST DER WERT, DER TATSAECHLICH LAEUFT.
#      Snapmakers Code laedt ihn beim Start und ueberschreibt damit die Config;
#      jedes "SET_INPUT_SHAPER SAVE=1" (also jeder Kalibrierlauf) schreibt ihn neu.
#
# ⚠ Wer hier etwas aendert und nicht auch das JSON anfasst, aendert am laufenden
#   Drucker GAR NICHTS. Zum Pruefen, was wirklich gilt:
#     curl -s "http://192.168.178.136:7125/printer/objects/query?configfile" \
#       | jq '.result.status.configfile.settings.input_shaper'
#   und die Zeile "shaper_type_x:... smoother_freq_x:..." in /oem/klippylogs/klippy.log.
#
# Stand 2026-08-25: Messlauf 07:21 ergab 51.2/46.0, ein zweiter Lauf um 09:44 ergab
# 51.4/46.0 (Streuung von 0,4 % - Messrauschen, kein Widerspruch). Der Fallback hier
# ist auf den aktiven Wert nachgezogen, damit .cfg und JSON nicht auseinanderlaufen.
# Bauart und Herkunft der Werte: Memory u1-input-shaper-nicht-persistent.

[input_shaper]
shaper_type_x: smooth_mzv
shaper_freq_x: 51.4
shaper_type_y: smooth_mzv
shaper_freq_y: 46.0
