# PID-Autotune fuer alle vier Werkzeugkoepfe des U1.
# Nach einem Duesen-/Hotend-Wechsel sinnvoll, weil jeder Kopf eine eigene
# Heizpatrone hat und die Regelparameter ab Werk fuer alle vier identisch sind.
#
# Aufruf:   PID_ALL                 -> kalibriert auf 240 C
#           PID_ALL PIDTEMP=250     -> eigene Temperatur (Druck-Temperatur waehlen)
#           PID_ALL SAVE=0          -> ohne SAVE_CONFIG/Neustart
#
# Einzelner Kopf geht auch ohne Makro:
#           PID_CALIBRATE HEATER=extruder1 TARGET=250
#           (extruder = Kopf 0, extruder1 = Kopf 1, ... extruder3 = Kopf 3)
#
# Das Bett kann NICHT kalibriert werden: [heater_bed] hat allow_pid_calibrate: False.
#
# Vorlage: Reddit r/SnapmakerU1 "I made a PID Autotune Macro", angepasst:
#  - Endtemperatur 240 statt 260 (Standard hier ist PLA/PETG, nicht Nylon)
#  - TURN_OFF_HEATERS am Ende, damit kein Kopf heiss stehen bleibt
#  - PARK_EXTRUDER3 statt park_extruder am Anfang: der Toolwechsel T0..T3 legt
#    den vorherigen Kopf ohnehin selbst ab, nur der letzte bleibt sonst haengen
#  - Abbruch, wenn ein Druck laeuft, und Plausibilitaetspruefung der Temperatur

[gcode_macro PID_ALL]
description: PID-Autotune aller vier Werkzeugkoepfe (Parameter PIDTEMP, SAVE)
gcode:
    {% set PIDTEMP = params.PIDTEMP|default(240)|int %}
    {% set DO_SAVE = params.SAVE|default(1)|int %}

    {% if printer.print_stats.state in ['printing', 'paused'] %}
        { action_raise_error("PID_ALL: Es laeuft ein Druck - abgebrochen.") }
    {% endif %}
    {% if PIDTEMP < 180 or PIDTEMP > 300 %}
        { action_raise_error("PID_ALL: PIDTEMP=%d liegt ausserhalb 180-300 C." % PIDTEMP) }
    {% endif %}

    SET_LED LED=cavity_led WHITE=1
    M117 PID: Referenzfahrt
    G28
    G90
    G1 Z50 F1200

    M117 PID: Kopf 0 holen
    T0
    G28 X
    M117 PID: Kopf 0 kalibrieren
    PID_CALIBRATE HEATER=extruder TARGET={PIDTEMP}

    M117 PID: Kopf 1 holen
    T1
    G28 X
    M117 PID: Kopf 1 kalibrieren
    PID_CALIBRATE HEATER=extruder1 TARGET={PIDTEMP}

    M117 PID: Kopf 2 holen
    T2
    G28 X
    M117 PID: Kopf 2 kalibrieren
    PID_CALIBRATE HEATER=extruder2 TARGET={PIDTEMP}

    M117 PID: Kopf 3 holen
    T3
    G28 X
    M117 PID: Kopf 3 kalibrieren
    PID_CALIBRATE HEATER=extruder3 TARGET={PIDTEMP}

    M117 PID: Abschluss
    TURN_OFF_HEATERS
    PARK_EXTRUDER3
    G28 X
    SET_LED LED=cavity_led WHITE=0
    {% if DO_SAVE %}
        M117 PID: SAVE_CONFIG - Klipper startet neu
        SAVE_CONFIG
    {% else %}
        M117 PID: fertig (ohne SAVE_CONFIG)
    {% endif %}

# ---------------------------------------------------------------------------
# Kompletter Servicelauf in einem Rutsch:
#   PID_SERVICE                 -> entladen, Autotune 240 C, wieder laden, speichern
#   PID_SERVICE PIDTEMP=250     -> eigene Kalibriertemperatur
#   PID_SERVICE SAVE=0          -> ohne SAVE_CONFIG/Neustart am Ende
#
# ACHTUNG beim Aendern: PID_ALL wird hier zwingend mit SAVE=0 aufgerufen.
# SAVE_CONFIG startet Klipper neu und wuerde alles Nachfolgende (das Laden!)
# verschlucken - deshalb steht es ganz am Schluss. Fuer die Persistenz der
# PID-Werte ist es ohnehin nicht noetig: PID_CALIBRATE schreibt sie sofort in
# snapmaker/extruder*_pid_parameters.json, und die JSON schlaegt die printer.cfg.
# ---------------------------------------------------------------------------

[gcode_macro PID_SERVICE]
description: Entladen + PID-Autotune aller Koepfe + wieder laden (PIDTEMP, SAVE)
gcode:
    {% set PIDTEMP = params.PIDTEMP|default(240)|int %}
    {% set DO_SAVE = params.SAVE|default(1)|int %}

    {% if printer.print_stats.state in ['printing', 'paused'] %}
        { action_raise_error("PID_SERVICE: Es laeuft ein Druck - abgebrochen.") }
    {% endif %}
    {% if PIDTEMP < 180 or PIDTEMP > 300 %}
        { action_raise_error("PID_SERVICE: PIDTEMP=%d liegt ausserhalb 180-300 C." % PIDTEMP) }
    {% endif %}

    RESPOND TYPE=echo MSG="PID_SERVICE 1/3: alle Koepfe entladen"
    UNLOAD_ALL

    RESPOND TYPE=echo MSG="PID_SERVICE 2/3: PID-Autotune bei {PIDTEMP} C"
    PID_ALL PIDTEMP={PIDTEMP} SAVE=0

    RESPOND TYPE=echo MSG="PID_SERVICE 3/3: alle Koepfe wieder laden"
    LOAD_ALL

    {% if DO_SAVE %}
        M117 PID_SERVICE: SAVE_CONFIG - Klipper startet neu
        SAVE_CONFIG
    {% else %}
        M117 PID_SERVICE fertig
        RESPOND TYPE=echo MSG="PID_SERVICE fertig (ohne SAVE_CONFIG)."
    {% endif %}
